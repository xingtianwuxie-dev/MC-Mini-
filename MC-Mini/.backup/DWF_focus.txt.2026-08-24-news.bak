focus_tree = {
	id = DWF_focus_tree
	country = {
		factor = 0
		modifier = {
			add = 10
			tag = DWF
		}
	}
	default = no

	##############################################################
	# DWF 多玩国策树（2026-08-21 首版落地;2026-08-22 XT定大拆）
	# 布局(XT定):政治线居中 / 工业线居左 / 军事+外交居右
	# ⚠️2026-08-21 debug实测:1.19无树级relative_position token,x/y全用绝对坐标
	# 中间列=12:政治协商同盟会议(y0,原「多玩一大召开」改名顶根)→开启内部检查(y2)
	#   2026-08-22删:旧根政协同盟会/威权社路线/解放阵线/双门槛对/红石线6策/共同体线5策(政治线XT重写中)
	# 左列=4:恢复生产(y1)→土地探勘(y2)→另一种可能(y3)→我是红岩(y4)(2026-08-22 XT工业线稿)
	#   ⚠️XT结构预告:我是红岩往下与政治线合流(政治线XT稿);工业线在恢复生产/土地探勘后另有别的分支(待稿)
	#   红岩定位(XT 2026-08-22):多玩自研基础AI,类ChatGPT但接入面广(政务/军委会/工程局/矿场全域终端)
	# 右列:整编西北16→{建军支14-18|开战支20|外交支24}
	# 图标=原版GFX_goal_generic_*(需GFX_前缀,名字已对照interface/*.gfx核实)
	# ⚠️三严与建军效果为占位,XT明言未定会改
	##############################################################

	# ===== 树根·政治线(中) =====
	# 2026-08-22 XT定:「多玩一大召开」改名「政治协商同盟会议」顶上树根(原根政协同盟会已删,奖励并入)
	focus = {
		id = DWF_first_congress
		x = 12
		y = 0
		cost = 5
		icon = GFX_focus_HJM_duowan_alliance_reform
		continue_if_invalid = no
		cancel_if_invalid = yes
		completion_reward = {
			add_political_power = 120			# 会议确立两大三小格局与党争规则
			set_country_flag = DWF_first_congress_held
			set_cosmetic_tag = DWF_players_alliance			# 会议正式立「多玩玩家同盟」(改名链:联邦→同盟)
			add_ideas = DWF_temporary_unity			# 临时团结:分歧还在,路先一起走(并入自原根)
			country_event = { id = DWF.1 days = 1 }			# 推举籽岷为国家主席(1.19.2用country_event非fire_event)
			country_event = { id = DWF.2 days = 3 }			# 机关班子逐项任命链:检查机关轮值起手→军委会→工程院→联络局
		}
	}
