	# ===== 旧岩石之令(2026-08-24 XT定) =====
	# 出自《我的世界:故事模式》初代岩石之令。分裂前=MC帝国(HJM)元帅/将军
	# ⚠️2026-08-24实测:引擎禁止同一角色分属两国(带country_leader的被第二国recruit必报already assigned)
	# 原版唯一解法instance双实例,但allowed只能用全局DLC条件(不认tag=国名)→无法做「分裂前HJM有/分裂后没有」时间线切换
	# XT定方案1:W01改国名「岩石之令」+旧五人用W01_独立角色名(W01_Soren等,共享索伦立绘+译名)
	# HJM这5个角色保持普通写法,分裂后HJM仍有(通过visible = has_government != feudalist 隐藏)
	HJM_Soren = {
		name = HJM_Soren
		portraits = {
			army = { large = "gfx/leaders/leader_unknown.dds" }
		}
		# HJM版索伦:纯陆军元帅(无country_leader,元首位留给W01)
		field_marshal = {
			traits = { brilliant_strategist }
			skill = 3
			attack_skill = 2
			defense_skill = 3
			planning_skill = 4
			logistics_skill = 2
			visible = {
				NOT = {
					has_government = fascism
				}
			}
		}
	}
