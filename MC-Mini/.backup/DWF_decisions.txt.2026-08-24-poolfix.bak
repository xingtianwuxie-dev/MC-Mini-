# DWF 决议(2026-08-21)——照TFR东协/太约竞争东南亚模式改造
# 机制记要:①宣战决议=军事线国策开权限,玩家选拉栓时机 ②军阀吸纳=白名单(平等入盟)/问罪(胁迫附庸)
# ③拉拢魔族=仅魔族五国+末地(军阀不走此路!),影响力var 0~1,六成入「志愿者计划」阵营
# ⚠️MST微软版拉拢阈值=四成(2026-08-21 XT定),写MST外交线时改
# 2026-08-21 debug实测修错:exists=TAG→country_exists;add_world_tension效果1.19已不存在(exe无此串),问罪攻势的外交代价改走稳定度

####################################################################################
# 一、军事行动(宣战决议,国策解锁)
####################################################################################
DWF_military_operations = {

	# 整编西北内陆地区解锁——宣战西北近邻军阀(西域三十六国梗)
	DWF_thirty_six_kingdoms = {
		icon = GFX_decision_generic_army
		visible = {
			has_country_flag = DWF_northwest_consolidated
		}
		fire_only_once = yes
		cost = 50
		complete_effect = {
			custom_effect_tooltip = DWF_thirty_six_kingdoms_tt
			every_country = {
				limit = {
					has_country_flag = DWF_warlord_group_nw
					NOT = { has_war_with = ROOT }
					NOT = { is_in_faction_with = ROOT }
				}
				ROOT = {
					declare_war_on = {
						target = PREV
						type = annex_everything
					}
				}
			}
		
		random_list = {
				25 = { country_event = { id = DWF_faction.51 } }
				25 = { country_event = { id = DWF_faction.52 } }
				25 = { country_event = { id = DWF_faction.53 } }
				25 = { country_event = { id = DWF_faction.54 } }
			}
		random_list = {
				25 = { country_event = { id = DWF_faction.51 } }
				25 = { country_event = { id = DWF_faction.52 } }
				25 = { country_event = { id = DWF_faction.53 } }
				25 = { country_event = { id = DWF_faction.54 } }
			}
		random_list = {
				25 = { country_event = { id = DWF_faction.51 } }
				25 = { country_event = { id = DWF_faction.52 } }
				25 = { country_event = { id = DWF_faction.53 } }
				25 = { country_event = { id = DWF_faction.54 } }
			}}
	}

	# 远西战略解锁之一——宣战中亚军阀(班超定远西域)
	DWF_dingyuan_plan = {
		icon = GFX_decision_generic_police_action
		visible = {
			has_country_flag = DWF_far_west_strategy_unlocked
		}
		fire_only_once = yes
		cost = 50
		complete_effect = {
			custom_effect_tooltip = DWF_dingyuan_plan_tt
			every_country = {
				limit = {
					has_country_flag = DWF_warlord_group_ca
					NOT = { has_war_with = ROOT }
					NOT = { is_in_faction_with = ROOT }
				}
				ROOT = {
					declare_war_on = {
						target = PREV
						type = annex_everything
					}
				}
			}
		}
	}

	# 远西战略解锁之二——宣战西藏军阀(世界屋脊)
	DWF_roof_offensive = {
		icon = GFX_decision_generic_police_action
		visible = {
			has_country_flag = DWF_far_west_strategy_unlocked
		}
		fire_only_once = yes
		cost = 50
		complete_effect = {
			custom_effect_tooltip = DWF_roof_offensive_tt
			every_country = {
				limit = {
					has_country_flag = DWF_warlord_group_tibet
					NOT = { has_war_with = ROOT }
					NOT = { is_in_faction_with = ROOT }
				}
				ROOT = {
					declare_war_on = {
						target = PREV
						type = annex_everything
					}
				}
			}
		}
	}

	# 清洗右派敌人解锁——宣战东北军阀+网易NTE(白山黑水=东北古称)
	DWF_baishan_heishui_offensive = {
		icon = GFX_decision_generic_ignite_civil_war
		visible = {
			has_country_flag = DWF_purge_rightists_unlocked
		}
		fire_only_once = yes
		cost = 75
		complete_effect = {
			custom_effect_tooltip = DWF_baishan_heishui_offensive_tt
			every_country = {
				limit = {
					has_country_flag = DWF_warlord_group_ne
					NOT = { has_war_with = ROOT }
					NOT = { is_in_faction_with = ROOT }
				}
				ROOT = {
					declare_war_on = {
						target = PREV
						type = annex_everything
					}
				}
			}
			# 网易NTE本尊
			if = {
				limit = { country_exists = NTE }
				NTE = {
					if = {
						limit = {
							NOT = { has_war_with = ROOT }
							NOT = { is_in_faction_with = ROOT }
						}
						ROOT = {
							declare_war_on = {
								target = PREV
								type = annex_everything
							}
						}
					}
				}
			}
		}
	}

	# 再造MC解锁——向全部国家宣战(WorldEdit梗:重写整个地图)
	DWF_world_edit_program = {
		icon = GFX_decision_generic_ignite_civil_war
		visible = {
			has_country_flag = DWF_rebuild_mc_unlocked
		}
		fire_only_once = yes
		cost = 100
		complete_effect = {
			custom_effect_tooltip = DWF_world_edit_program_tt
			add_war_support = 0.10
			every_country = {
				limit = {
					has_country_flag = MC_former_imperial		# 2026-08-24 XT定:只打前帝国圈(收复统一),不打全世界
					NOT = { tag = DWF }
					NOT = { has_war_with = ROOT }
					NOT = { is_in_faction_with = ROOT }
					NOT = { is_puppet_of = ROOT }
				}
				ROOT = {
					declare_war_on = {
						target = PREV
						type = annex_everything
					}
				}
			}
		}
	}
}

####################################################################################
# 二、外交吸纳(targeted决议:目标=西北近邻军阀)
####################################################################################
DWF_diplomatic_absorption = {

	# 团结一切力量解锁——和平吸纳:平等加入阵营(MC服务器白名单梗)
	DWF_whitelist_plan = {
		icon = GFX_decision_generic_political_discourse
		visible = {
			has_country_flag = DWF_whitelist_plan_unlocked
		}
		target_trigger = {
			# 2026-08-24 西线睦邻:中亚(ca)目标经flag解锁
			OR = {
				has_country_flag = DWF_warlord_group_nw
				AND = {
					has_country_flag = DWF_warlord_group_ca
					ROOT = { has_country_flag = DWF_western_neighbors_pact }
				}
			}
			is_in_faction = no
			NOT = { has_war_with = ROOT }
			NOT = { has_country_flag = DWF_whitelisted_by_dwf }
		}
		cost = 25
		complete_effect = {
			FROM = { set_country_flag = DWF_whitelisted_by_dwf }
			add_to_faction = FROM
			FROM = { add_stability = 0.05 }			# 入盟红利:稳定+5%
			if = { limit = { has_country_flag = DWF_western_neighbors_pact } add_political_power = 5 }			# 睦邻返点(等效-20%)
		}
		ai_will_do = {
			base = 30
		}
	}

	# 不做无用的牺牲解锁——武力胁迫:城下之盟,附庸入盟
	DWF_questioning_offensive = {
		icon = GFX_decision_generic_police_action
		visible = {
			has_country_flag = DWF_questioning_offensive_unlocked
		}
		target_trigger = {
			# 2026-08-24 西线睦邻:中亚(ca)目标经flag解锁
			OR = {
				has_country_flag = DWF_warlord_group_nw
				AND = {
					has_country_flag = DWF_warlord_group_ca
					ROOT = { has_country_flag = DWF_western_neighbors_pact }
				}
			}
			is_in_faction = no
			NOT = { has_war_with = ROOT }
			NOT = { has_country_flag = DWF_forced_by_dwf }
		}
		cost = 50
		complete_effect = {
			FROM = { set_country_flag = DWF_forced_by_dwf }
			FROM = { puppet = ROOT }
			add_to_faction = FROM
			FROM = { add_war_support = 0.10 }			# 被胁迫者的觉悟
			add_stability = -0.02
			if = { limit = { has_country_flag = DWF_western_neighbors_pact } add_political_power = 10 }			# 睦邻返点(等效-20%)
		}
		ai_will_do = {
			base = 10
		}
	}
}

