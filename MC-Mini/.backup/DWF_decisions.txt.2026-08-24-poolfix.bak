# ===== 政治斗争类:BOP拉扯(2026-08-22;BOP定义 common/bop/DWF_bop.txt) =====
DWF_politics_category = {
	DWF_coordination_lobbying = {
		icon = GFX_decision_category_generic_political_discourse
		cost = 50
		fire_only_once = no
		days_re_enable = 30
		allowed = { original_tag = DWF }
		visible = { has_power_balance = { id = DWF_coordination_liberation_bop } }
		available = {
			has_power_balance = { id = DWF_coordination_liberation_bop }
			NOT = { is_power_balance_in_range = { id = DWF_coordination_liberation_bop range = DWF_coordination_total_control_range } }
		}
		complete_effect = {
			add_power_balance_value = {
				id = DWF_coordination_liberation_bop
				value = 0.1
				tooltip_side = DWF_coordination_side
			}
		}
		ai_will_do = { factor = 1 }
	}
	DWF_liberation_lobbying = {
		icon = GFX_decision_category_generic_crisis
		cost = 50
		fire_only_once = no
		days_re_enable = 30
		allowed = { original_tag = DWF }
		visible = { has_power_balance = { id = DWF_coordination_liberation_bop } }
		available = {
			has_power_balance = { id = DWF_coordination_liberation_bop }
			NOT = { is_power_balance_in_range = { id = DWF_coordination_liberation_bop range = DWF_liberation_total_control_range } }
		}
		complete_effect = {
			add_power_balance_value = {
				id = DWF_coordination_liberation_bop
				value = -0.1
				tooltip_side = DWF_liberation_side
			}
		}
		ai_will_do = { factor = 1 }
	}
	DWF_cross_compromise = {
		icon = GFX_decision_category_generic_propaganda
		cost = 75
		fire_only_once = no
		days_re_enable = 45
		allowed = { original_tag = DWF }
		visible = { has_power_balance = { id = DWF_coordination_liberation_bop } }
		available = {
			has_power_balance = { id = DWF_coordination_liberation_bop }
			NOT = { is_power_balance_in_range = { id = DWF_coordination_liberation_bop range = DWF_balance_center_range } }
		}
		complete_effect = {
			# 向中位拉回0.1(方向按当前偏移自动)
			if = {
				limit = { power_balance_value = { id = DWF_coordination_liberation_bop value > 0 } }
				add_power_balance_value = { id = DWF_coordination_liberation_bop value = -0.1 }
			}
			else_if = {
				limit = { power_balance_value = { id = DWF_coordination_liberation_bop value < 0 } }
				add_power_balance_value = { id = DWF_coordination_liberation_bop value = 0.1 }
			}
		}
		ai_will_do = { factor = 1 }
	}
}

####################################################################################
# 四、矿物发掘(2026-08-22 XT定:「土地探勘」国策解锁;收复区域=组军阀全灭→该区域矿点决议可见)
# ⚠️西北六州只有两个州可发掘(XT定);槽/资源数值为占位待XT调
####################################################################################
DWF_mineral_prospecting = {

	# === 基础批:西北六州之二(XT定约束;开局自有地,土地探勘解锁即可见) ===
	# 北庭(准噶尔盆地):油田
	DWF_develop_beiting_oil = {
		icon = GFX_decision_generic_industry
		visible = {
			has_country_flag = DWF_mineral_prospecting_unlocked
		}
		available = {
			owns_state = 618
		}
		fire_only_once = yes
		cost = 25
		complete_effect = {
			custom_effect_tooltip = DWF_develop_beiting_oil_tt
			618 = {
				add_resource = { type = oil amount = 12 }
				add_extra_state_shared_building_slots = 1
			}
